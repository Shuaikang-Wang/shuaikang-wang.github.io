---
layout: default
---

{%- comment -%}
Compute a robust CV URL from page.cv_pdf:
- If it's an external link (contains ://), use as-is.
- If it's an absolute site path (starts with /), pass through relative_url.
- If it's a bare filename (e.g., cv_20251110.pdf), assume it's under /assets/cv/.
{%- endcomment -%}
{%- assign cv_url = page.cv_pdf | to_s -%}
{%- if cv_url != "" -%}
  {%- if cv_url contains '://' -%}
    {%- assign cv_url = cv_url -%}
  {%- else -%}
    {%- assign first_char = cv_url | slice: 0, 1 -%}
    {%- if first_char == '/' -%}
      {%- assign cv_url = cv_url | relative_url -%}
    {%- else -%}
      {%- assign cv_url = cv_url | prepend: '/assets/cv/' | relative_url -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
Optional: if you set `cv_redirect: true` in the page front matter,
the /cv/ page will immediately redirect to the PDF.
{%- endcomment -%}
{%- if page.cv_redirect and cv_url != "" -%}
  <script>window.location.replace("{{ cv_url }}");</script>
  <noscript><meta http-equiv="refresh" content="0; url={{ cv_url }}"></noscript>
{%- endif -%}

{%- assign using_resume_data = site.data.resume and site.data.resume != empty -%}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {%- if cv_url != "" -%}
        <a
          href="{{ cv_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          title="Open CV (PDF)"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {%- endif -%}
    </h1>
    {%- if page.description -%}
      <p class="post-description">{{ page.description }}</p>
    {%- endif -%}
  </header>

  <article>
    <div class="cv">
      {%- if not using_resume_data -%}
        {%- for entry in site.data.cv -%}
          <a class="anchor" id="{{ entry.title }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
            <div>
              {%- if entry.type == 'list' -%}
                {%- include cv/list.liquid -%}
              {%- elsif entry.type == 'map' -%}
                {%- include cv/map.liquid -%}
              {%- elsif entry.type == 'nested_list' -%}
                {%- include cv/nested_list.liquid -%}
              {%- elsif entry.type == 'time_table' -%}
                {%- include cv/time_table.liquid -%}
              {%- elsif entry.type == 'list_groups' -%}
                {%- include cv/list_groups.liquid -%}
              {%- else -%}
                {{ entry.contents }}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for data in site.data.resume -%}
          {%- if site.jsonresume and site.jsonresume.size > 0 -%}
            {%- unless site.jsonresume contains data[0] -%}
              {%- continue -%}
            {%- endunless -%}
          {%- endif -%}
          {%- if data[0] == 'meta' or data[1].size == 0 -%}{%- continue -%}{%- endif -%}
          <a class="anchor" id="{{ data[0] }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ data[0] | capitalize }}</h3>
            <div>
              {%- case data[0] -%}
                {%- when 'basics' -%}{%- include resume/basics.liquid -%}
                {%- when 'education' -%}{%- include resume/education.liquid -%}
                {%- when 'work' -%}{%- include resume/work.liquid -%}
                {%- when 'volunteer' -%}{%- include resume/volunteer.liquid -%}
                {%- when 'projects' -%}{%- include resume/projects.liquid -%}
                {%- when 'awards' -%}{%- include resume/awards.liquid -%}
                {%- when 'skills' -%}{%- include resume/skills.liquid -%}
                {%- when 'publications' -%}{%- include resume/publications.liquid -%}
                {%- when 'languages' -%}{%- include resume/languages.liquid -%}
                {%- when 'interests' -%}{%- include resume/interests.liquid -%}
                {%- when 'certificates' -%}{%- include resume/certificates.liquid -%}
                {%- when 'references' -%}{%- include resume/references.liquid -%}
                {%- else -%}
                  {# no-op #}
              {%- endcase -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </article>
</div>
